# ══════════════════════════════════════════════════════════════════════
#  Traefik reverse proxy — environment template
#
#    cp .env.example .env   →   then edit the values below.
#
#  Rules of this file:
#    * Whole-line comments only (no trailing '#' after a value).
#    * Values pass through docker-compose interpolation: double every '$' in
#      a value (bcrypt hashes need this) — a raw '$' is read as a variable.
#    * Value semantics follow docker compose's .env format; the render step
#      (bin/derive.sh) reads the same file and unescapes '$$' back to '$'.
#
#  .env and cf-token are git-ignored. NEVER commit them.
#  Secrets policy: the Cloudflare token lives in ./cf-token (Docker secret);
#  non-secret configuration lives here.
# ══════════════════════════════════════════════════════════════════════

# ── Image ────────────────────────────────────────────────────────────
TRAEFIK_IMAGE=traefik
# Pin a minor tag in production; avoid `latest`.
TRAEFIK_TAG=v3.7

# ── Domains ──────────────────────────────────────────────────────────
# Base zone (your Cloudflare zone) + subdomains.
#   Dashboard host  = <DASHBOARD_SUBDOMAIN>.<DOMAIN>   (composed by the
#     dashboard label in docker-compose.yml — that file is user-owned; no
#     script ever modifies it).
#   WireGuard host  = <WIREGUARD_SUBDOMAIN>.<DOMAIN>   (rendered into
#     config/config.yml by the templates).
DOMAIN=example.com
DASHBOARD_SUBDOMAIN=traefik
WIREGUARD_SUBDOMAIN=wireguard

# Optional: override the WireGuard host with a fully-qualified name
# (takes precedence over WIREGUARD_SUBDOMAIN.DOMAIN).
# WIREGUARD_DOMAIN=wg.example.com

# ── Cloudflare / ACME ────────────────────────────────────────────────
# Cloudflare account email: used by the Cloudflare API (DNS-01 challenge)
# and as the Let's Encrypt account email.
CF_API_EMAIL=<your_cloudflare_email>@example.com
# Optional, defaults to CF_API_EMAIL.
# ACME_EMAIL=other@example.com
# true = sign up against the Let's Encrypt STAGING CA (testing only!).
ACME_STAGING=false

# ── Network / addressing ─────────────────────────────────────────────
# Shared network that Traefik and all backend services join. It is declared
# `external: true` in the compose file — `just bootstrap` (or `just up`)
# creates it idempotently if missing, and reuses it if present.
PROXY_NETWORK=proxy
# Subnet used ONLY when the network is being created; ignored for one that
# already exists (make sure TRAEFIK_IP falls inside its actual subnet).
PROXY_SUBNET=172.18.0.0/24
# Traefik's fixed address on that network.
TRAEFIK_IP=172.18.0.254

# ── Ports ────────────────────────────────────────────────────────────
# Host port for the HTTPS entrypoint (container always listens on 443).
ENTRYPOINT_HTTPS_PORT=443

# ── WireGuard backend (forwarded from WIREGUARD_DOMAIN) ──────────────
# Internal address of your WireGuard management endpoint.
WIREGUARD_HOST=192.168.0.10
WIREGUARD_PORT=51821
# http or https
WIREGUARD_SCHEME=http

# ── Authentik outpost (optional forward-auth, see config template) ───
AUTHENTIK_HOST=authentik
AUTHENTIK_PORT=9000

# ── Dashboard auth ───────────────────────────────────────────────────
# A BCRYPT entry:  <user>:$2y$<hash>   (plaintext is rejected by bin/derive.sh).
# DOUBLE every dollar sign in this file (compose interpolates .env values);
# easiest way:  just cred <username> <password>   (uses htpasswd for you).
TRAEFIK_DASHBOARD_CREDENTIALS=admin:$$2y$$05$$REPLACE_WITH_REAL_BCRYPT

# ── Misc ─────────────────────────────────────────────────────────────
# Enable Traefik's /debug endpoints (default false).
# TRAEFIK_API_DEBUG=false
# Named volume holding ACME state — back it up!
# CERTS_VOLUME=traefik-certs
